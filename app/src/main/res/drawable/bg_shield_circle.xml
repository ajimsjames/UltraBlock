<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/theme_card" />
            <stroke android:width="3.5dp" android:color="@color/text_primary" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/theme_pill" />
            <stroke android:width="2dp" android:color="@color/text_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/theme_shield_bg" />
            <stroke android:width="2dp" android:color="@color/theme_card_stroke" />
        </shape>
    </item>
</selector>
