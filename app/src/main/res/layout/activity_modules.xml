<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingVertical="24dp">

        <!-- Back Nav Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="← BACK"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:text="FIREWALL MODULES"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Configure granular telemetry, ad server, and OEM analytics sinkholing"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Smart TV ACR & Sony Bravia Telemetry -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchBlockSmartTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:text="Block Smart TV &amp; Samba ACR Telemetry"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                app:thumbTint="@color/text_primary"
                app:trackTint="@color/theme_card_stroke" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color" />

            <!-- Mobile & TV In-App Ad Networks -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchBlockInAppAds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:text="Block In-App &amp; TV Ad Networks (Vungle / AppLovin / InMobi)"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                app:thumbTint="@color/text_primary"
                app:trackTint="@color/theme_card_stroke" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color" />

            <!-- App Trackers -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchBlockAppTrackers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:text="Block App Trackers (AppsFlyer / CleverTap / MoEngage)"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                app:thumbTint="@color/text_primary"
                app:trackTint="@color/theme_card_stroke" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color" />

            <!-- WPS Office Switch -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchBlockWps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:text="Block WPS Office / Kingsoft Analytics"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                app:thumbTint="@color/text_primary"
                app:trackTint="@color/theme_card_stroke" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color" />

            <!-- Realme / Oppo Switch -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchBlockRealme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:text="Block Realme &amp; HeyTap Cloud Telemetry"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                app:thumbTint="@color/text_primary"
                app:trackTint="@color/theme_card_stroke" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color" />

            <!-- Meta / Facebook Switch -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchBlockMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:text="Block Meta / Facebook Graph &amp; Trackers"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                app:thumbTint="@color/text_primary"
                app:trackTint="@color/theme_card_stroke" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color" />

            <!-- Xiaomi / MIUI Switch -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchBlockXiaomi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:text="Block Xiaomi &amp; MIUI Telemetry"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                app:thumbTint="@color/text_primary"
                app:trackTint="@color/theme_card_stroke" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color" />

            <!-- ByteDance / TikTok Switch -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchBlockBytedance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:text="Block ByteDance / TikTok Tracking"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                app:thumbTint="@color/text_primary"
                app:trackTint="@color/theme_card_stroke" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
