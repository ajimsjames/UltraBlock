<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0E"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Top TV Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_tv_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/accent_white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:text="BLOCKED TV APPS &amp; TRACKERS"
                android:textColor="@color/accent_white"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/txtTotalSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Per-App Ad &amp; Tracker Breakdown (Use D-Pad to toggle bypass)"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnClearStats"
            android:layout_width="120dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_tv_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:text="RESET STATS"
            android:textColor="@color/accent_red"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#20202C" />

    <TextView
        android:id="@+id/txtEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:gravity="center"
        android:text="No ads blocked yet.\nAs TV apps attempt ad or tracking queries, they will appear here."
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- TV Grid/List of apps -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewApps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="16dp" />

</LinearLayout>
